# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Database -------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Forecast source under test ------------------------------------------
# TWC API Hub key. Chris creates this account personally; see docs/access-notes.md.
TWC_API_KEY=

# --- Raw payload storage --------------------------------------------------
# Either a local directory (development)...
RAW_STORAGE_DIR=./data/raw
# ...or Supabase Storage (production). The bucket is written with x-upsert:false
# so raw payloads are append-only at the storage layer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RAW_BUCKET=kjyo-forecast-raw

# --- Alerts ---------------------------------------------------------------
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Optional -------------------------------------------------------------
# KJYO_CONFIG=config/config.yaml
